        <mxCell id="PAGE_08_E08_C6" value="event matching" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_08_P08_QEVENT" target="PAGE_08_P08_SEVENT">
