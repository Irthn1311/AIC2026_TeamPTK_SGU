  <diagram id="PAGE_03" name="03 — Online Query &amp; Retrieval">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PAGE_03_G03_QUERY" value="Query Understanding &amp;amp; Ledger" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#fef3c7;strokeColor=#ca8a04;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1380" height="700" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_G03_RETRIEVAL" value="Retrieval" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="1430" y="20" width="2500" height="700" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_G03_ROUTE" value="Lane Decision" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#fef3c7;strokeColor=#ca8a04;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="3960" y="20" width="500" height="700" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M8" value="&lt;b&gt;M8 — Query Input&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] KIS event · Q&amp;amp;A event+question · TRAKE sequence&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TAI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Natural-language task request&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Capture exact original query and task hints&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Task input schema&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Immutable original query&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; query-request&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Missing task fields&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Reject malformed request with clear schema error." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M9" value="&lt;b&gt;M9 — Query Ledger&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Original query is never overwritten&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Original query → Runtime events&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Append-only hypothesis and execution history&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Versioned QueryLedger contract&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; QueryLedger&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; query-ledger-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Lost provenance → Query overwrite&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Preserve original request and deterministic trace minimum." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="100" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M10" value="&lt;b&gt;M10 — Task Policy&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Route KIS · Q&amp;amp;A · TRAKE&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Original query → Explicit task type&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Select output schema → required evidence and solver policy&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Deterministic task router&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; TaskPolicy&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; task-policy&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Ambiguous task type&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Require explicit task type; never infer output tuple silently." style="shape=rhombus;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="280" height="280" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M11" value="&lt;b&gt;M11 — Query Compiler&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Rules baseline · bounded LLM candidate&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Original query → TaskPolicy&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Rule/template parsing → Optional structured LLM output → Schema validation&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Baseline deterministic parser → Candidate bounded LLM&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; CompiledQuery → QueryEvent list → Query hypotheses&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; compiled-query-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Unsupported parse → Invalid structured output → Hallucinated constraint&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Use original query plus conservative lexical/visual hypothesis." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="100" width="340" height="340" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M12" value="&lt;b&gt;M12 — Fast Probe&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Cheap retrieval confidence estimate&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; CompiledQuery → Primary indexes&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Primary visual search → Optional object/OCR probe → Group by video → Compute score margin → Variant agreement → Concentration and evidence coverage&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Existing NumPy retrieval contract → Baseline grouping&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; InitialCandidates → UncertaintySignals&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; fast-probe-result&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Flat scores → Conflicting variants → Empty result&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Expand modalities and candidate budget." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1470" y="100" width="320" height="320" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M13" value="&lt;b&gt;M13 — Modality Router&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Deterministic rules baseline&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; CompiledQuery → UncertaintySignals&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Choose visual → segment → object → OCR → ASR → caption and metadata tools&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Baseline deterministic task/query rules → Candidate bounded Agent routing&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; RetrievalToolCall list&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; retrieval-plan&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Missing needed modality → Repeated tool call&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Primary visual plus object/OCR hints when explicit." style="shape=rhombus;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1820" y="100" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M14" value="&lt;b&gt;M14 — Multimodal Retrieval&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Every branch returns rank, score, source and evidence refs&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; RetrievalToolCall list → Corpus indexes&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Search selected modalities independently&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; visual_frame_search → segment_search → object_search → OCR_search → ASR_search → caption_search → metadata_search&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Branch CandidateFrame/Segment lists&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; retrieval-branch-results&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Index unavailable → Dimension mismatch → Empty branch&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Continue available branches and record missing branch." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2150" y="100" width="340" height="340" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M15" value="&lt;b&gt;M15 — Fusion&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT_TEMPLATE] Reciprocal Rank Fusion baseline&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Multiple ranked branch lists&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Weighted reciprocal rank aggregation&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; RRF score = sum weight / (k + rank)&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Fused CandidateFrame list&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; fusion-result&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Dominant noisy branch → Duplicate candidate&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Primary visual ranking with explicit branch provenance." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2520" y="100" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M16" value="&lt;b&gt;M16 — Grouping &amp;amp; Deduplication&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT_TEMPLATE] Frame → temporal cluster → shot → video&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Fused CandidateFrame list&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Temporal clustering → Shot grouping → Duplicate suppression → Video grouping → Representative selection&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Nearby-frame deduplication and video grouping baseline&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Grouped candidates by video&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; candidate-groups&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Over-deduplication → Cluster boundary error&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Keep highest-score candidate per conservative window." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2850" y="100" width="320" height="320" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M17" value="&lt;b&gt;M17 — Candidate Video Ranker&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] KIS/Q&amp;amp;A evidence scores · TRAKE event coverage/order&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Grouped candidates → QueryEvent list&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Best-frame → Top-k pooled → Modality agreement → Distinctive evidence → Event coverage → Order feasibility → Compactness and penalties&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Current best-frame/top-k mean → Candidate task-aware video ranker&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; CandidateVideo list&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; candidate-video-ranking&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Wrong video dominates → Missing event → Infeasible order&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Rank by best primary visual frame plus modality agreement." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3200" y="100" width="340" height="340" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_M18" value="&lt;b&gt;M18 — Uncertainty Manager&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Fast Lane vs Graph Lane&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; CandidateVideo list → Task → Score margin → Evidence coverage&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Fast for one clear event; Graph for TRAKE → multi-event → temporal/entity constraints → ambiguity → complex Q&amp;amp;A or missing evidence&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Deterministic uncertainty thresholds&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; LaneDecision&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; uncertainty-decision&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Premature fast route → Unnecessary graph cost&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Prefer Graph Lane when temporal constraints are explicit." style="shape=rhombus;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4000" y="100" width="420" height="340" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_01" value="immutable query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_03_P03_M8" target="PAGE_03_P03_M9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_02" value="task request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#a16207;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_03_P03_M9" target="PAGE_03_P03_M10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_03" value="task policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#a16207;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_03_P03_M10" target="PAGE_03_P03_M11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_04" value="compiled query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_03_P03_M11" target="PAGE_03_P03_M12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_05" value="probe and uncertainty" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#a16207;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_03_P03_M12" target="PAGE_03_P03_M13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_06" value="tool calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#a16207;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_03_P03_M13" target="PAGE_03_P03_M14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_07" value="ranked branch lists" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_03_P03_M14" target="PAGE_03_P03_M15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_08" value="fused candidates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_03_P03_M15" target="PAGE_03_P03_M16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_09" value="video groups" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_03_P03_M16" target="PAGE_03_P03_M17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_10" value="ranked candidate videos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_03_P03_M17" target="PAGE_03_P03_M18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_E03_LEDGER" value="ARTIFACT: candidates and lane decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_03_P03_M18" target="PAGE_03_P03_M9">
