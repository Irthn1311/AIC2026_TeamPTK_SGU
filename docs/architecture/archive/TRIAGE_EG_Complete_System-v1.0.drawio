        <mxCell id="PAGE_06_P06_K1" value="&lt;b&gt;KIS-1 — Text Description&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Event description input&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TAI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Natural-language event&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Preserve original query&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; KIS request schema&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; KIS query&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; query-ledger&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
