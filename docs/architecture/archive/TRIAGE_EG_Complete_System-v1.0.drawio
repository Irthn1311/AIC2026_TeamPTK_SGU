        <mxCell id="PAGE_02_E02_057" value="segment context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7c3aed;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_02_P02_M53" target="PAGE_02_P02_M57">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_02_E02_06A" value="ARTIFACT: BTC FeatureRecord" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_02_P02_M51" target="PAGE_02_P02_M6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_02_E02_06B" value="ARTIFACT: Team FeatureRecord" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_02_P02_M52" target="PAGE_02_P02_M6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_02_E02_06C" value="ARTIFACT: object evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_02_P02_M54" target="PAGE_02_P02_M6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_02_E02_06D" value="ARTIFACT: OCR spans" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_02_P02_M55" target="PAGE_02_P02_M6">
          <mxGeometry relative="1" as="geometry" />
