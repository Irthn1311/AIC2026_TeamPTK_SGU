        <mxCell id="PAGE_06_P06_K2" value="&lt;b&gt;KIS-2 — Compile &amp;amp; Fast Probe&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Actor/action/object/location hints&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; KIS query&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Compile roles → Run primary visual probe → Estimate uncertainty&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Rules baseline&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Compiled KIS → Probe candidates&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; compiled-query&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="330" height="280" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_K3" value="&lt;b&gt;KIS-3 — Multimodal Retrieval &amp;amp; Fusion&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Visual/Object/OCR/Metadata + RRF&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Compiled KIS → Corpus indexes&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Retrieve branches → RRF → Group and deduplicate&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; NumPy/ANN adapters → RRF&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Grouped CandidateFrame list&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; retrieval-results&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="710" y="100" width="390" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_K4" value="&lt;b&gt;KIS-4 — Candidate Video Ranking&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Best frame, pooled score and agreement&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Grouped candidates&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Rank CandidateVideo → Assess ambiguity&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Best-frame/top-k baseline&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Ranked candidate videos&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; candidate-video-ranking&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="100" width="330" height="280" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_K5" value="&lt;b&gt;KIS-5 — Local Refinement &amp;amp; Verification&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Graph Lane only for complex/ambiguous KIS&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; CandidateVideo → Query moment&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Local frame refinement → Optional graph lane → Semantic Moment localization when needed → Evidence verification&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; In-video search → Dense decode candidate&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Verified KIS frame hypotheses&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; evidence-packets&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1490" y="100" width="430" height="320" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_K6" value="&lt;b&gt;KIS-6 — Ranked KIS Answers&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] video_id, frame_id&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TAI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Verified KIS hypotheses&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Rank best frame → nearby meaningful alternative and alternative video&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Ranked Answer List Constructor&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Up to 100 KIS tuples&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; kis-submission&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1950" y="100" width="330" height="280" as="geometry" />
