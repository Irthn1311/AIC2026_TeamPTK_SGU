  <diagram id="PAGE_04" name="04 — Event Graph Internals">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PAGE_04_G04_GRAPHS" value="Query Graph &amp;amp; Candidate Local Graph" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#ffedd5;strokeColor=#ea580c;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1520" height="780" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_G04_SEMANTICS" value="Graph Semantics" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#ffedd5;strokeColor=#ea580c;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="1570" y="20" width="1060" height="780" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_G04_SOLVER" value="Matching" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#ffedd5;strokeColor=#ea580c;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="2660" y="20" width="1760" height="780" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_P04_M19" value="&lt;b&gt;M19 — Query Event Graph&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Explicit · Inferred · Hypothesis constraints&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Compiled QueryEvent list&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Create QueryEventNode → Add BEFORE/AFTER/OVERLAPS/SAME_VIDEO/POSSIBLE_SAME_ACTOR&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Typed query graph contract&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Versioned Query Event Graph&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; query-event-graph-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Ambiguous span → Conflicting constraints&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Keep multiple conservative hypotheses." style="ellipse;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="430" height="380" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_P04_M20" value="&lt;b&gt;M20 — Candidate Local Event Graph Builder&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Top candidate videos only&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Top CandidateVideo → Retrieved/neighbor segments → Skeleton catalog → Evidence refs&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Create VideoNode → SegmentEventNode → EntityHypothesisNode → SemanticMomentHypothesisNode&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Directed attributed heterogeneous temporal graph with versioned query-local refinement&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Candidate Local Event Graph&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; candidate-local-event-graph-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Locality bias → Missing segment → Graph explosion&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Bounded timeline with deterministic temporal edges only." style="ellipse;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="470" height="420" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_P04_M21" value="&lt;b&gt;M21 — Graph Types &amp;amp; Semantics&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Core · Soft · On-demand edges&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Candidate graph nodes → Evidence references&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Type edges and mark confidence/status/provenance&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Typed edge registry&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Semantically typed local graph&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; graph-schema-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Causal hallucination → Hardening soft relation&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Downgrade uncertain relation to hypothesis or evidence reference." style="ellipse;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="100" width="470" height="420" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_P04_M22" value="&lt;b&gt;M22 — Confidence &amp;amp; Provenance&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Every hypothesis is traceable and stateful&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Graph hypotheses → Model/tool executions → Source evidence&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Attach source model/version → prompt version → frames/clip → creation time → graph version and verification method → Set hypothesis status&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; segment_hypothesis → event_hypothesis → verified_event → rejected_event → incomplete_event&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; ConfidenceComponents → ProvenanceRecord → NodeStatus&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; graph-provenance-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Missing source refs → Stale version → Uncalibrated confidence&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Mark incomplete_event and block unsupported promotion." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1610" y="100" width="470" height="440" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_P04_M23" value="&lt;b&gt;M23 — Event Matcher&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] QueryEvent ↔ CandidateEvent evidence scoring&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Query Event Graph → Candidate Local Event Graph → Evidence references&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Score visual → caption → object → OCR → ASR → region → motion/action and metadata support&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Weighted evidence scoring with provenance&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; EventMatchMatrix&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; event-match-matrix&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Cross-modal conflict → Missing modality&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Use available high-confidence signals and uncertainty penalty." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2700" y="100" width="380" height="340" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_P04_M24" value="&lt;b&gt;M24 — Temporal &amp;amp; Entity Solver&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] DP · Beam · Monotonic Alignment · Limited Graph Search&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; EventMatchMatrix → Temporal graph → Entity constraints&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Linear DP/Beam/Monotonic alignment → Constraint-guided beam for branch/overlap → Top-M repeated-event chains&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Dynamic Programming → Beam Search → Constraint scoring → Limited Graph Search&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Top-M EventChain hypotheses&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; event-chain-hypotheses&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Missing event → Contradiction → Combinatorial expansion&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Monotonic best-match chain with explicit missing-event penalty." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3110" y="100" width="450" height="420" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_P04_M25" value="&lt;b&gt;M25 — Entity Consistency&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CANDIDATE] Usually a soft relation&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; EntityHypothesis nodes → Tracks and evidence&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Aggregate identity evidence conservatively&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Candidate tracking and appearance embeddings&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; same_entity → possible_same_entity → different_entity&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; entity-consistency-result&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Occlusion → Similar appearance → Track switch&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; possible_same_entity with uncertainty penalty." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3590" y="100" width="380" height="360" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_P04_M26" value="&lt;b&gt;M26 — Gap Detector &amp;amp; Graph Expansion&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] EXPLOIT local evidence + EXPLORE alternatives&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Event chains → Confidence/Provenance → Missing evidence&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Classify gap → Balance bounded EXPLOIT and EXPLORE → Record expansion provenance&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Rule-based gap policies → Budgeted tool calls&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; GraphExpansionRequest or GlobalResearchRequest&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; gap-expansion-trace&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Locality bias → Infinite refinement → Budget overflow&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Stop with insufficient evidence or deterministic global visual re-search." style="shape=rhombus;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4000" y="100" width="380" height="400" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_E04_QM" value="QueryEvent constraints" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_04_P04_M19" target="PAGE_04_P04_M23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_E04_CG" value="local graph nodes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_04_P04_M20" target="PAGE_04_P04_M21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_E04_SP" value="typed hypotheses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_04_P04_M21" target="PAGE_04_P04_M22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_E04_CM" value="CandidateEvent nodes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_04_P04_M20" target="PAGE_04_P04_M23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_E04_EV" value="EVIDENCE: confidence and evidence refs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#be123c;" edge="1" parent="1" source="PAGE_04_P04_M22" target="PAGE_04_P04_M23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_E04_MS" value="EventMatchMatrix" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_04_P04_M23" target="PAGE_04_P04_M24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_E04_SE" value="entity hypotheses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7c3aed;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_04_P04_M24" target="PAGE_04_P04_M25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_E04_SG" value="chain gaps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_04_P04_M24" target="PAGE_04_P04_M26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_E04_EG" value="identity uncertainty" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_04_P04_M25" target="PAGE_04_P04_M26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_04_E04_BACK" value="bounded local expansion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#a16207;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_04_P04_M26" target="PAGE_04_P04_M20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="PAGE_05" name="05 — Fine Grounding &amp; Verification">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PAGE_05_G05_GROUND" value="Fine Grounding on Raw Video" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1900" height="760" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_G05_VERIFY" value="Evidence Verification" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="1950" y="20" width="900" height="760" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_G05_QA" value="Q&amp;amp;A Evidence Extraction" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#e2e8f0;strokeColor=#475569;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="2880" y="20" width="1480" height="760" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_P05_M27" value="&lt;b&gt;M27 — In-video Search&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Search only inside selected CandidateVideo&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; CandidateVideo → QueryEvent → Coarse interval&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Retrieve neighboring frames → Search candidate timeline → Refine event interval&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Local vector/evidence search&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; RefinedEventInterval&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; refined-event-interval&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Wrong coarse interval → Missing neighboring frames&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Expand temporal margin within the same video." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="360" height="320" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_P05_M28" value="&lt;b&gt;M28 — Dense Raw-video Decoder&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Preserve exact actual_frame_id and FPS mapping&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHAT&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Raw Video → Start/end interval → Temporal margin → FPS&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Decode frames → Preserve actual IDs → Build local before/after states&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Video reader adapter TBD; no offline motion core requirement&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; DenseFrameWindow&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; dense-frame-window&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Decode error → Variable FPS mismatch → Excessive window&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Coarser uniform sampling then focused decode around best frame." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="380" height="340" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_P05_M29" value="&lt;b&gt;M29 — Semantic Moment Localizer&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CANDIDATE] Event Graph finds interval; Localizer finds exact frame&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; DenseFrameWindow → Query moment definition → Region/object/motion evidence&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Score frame → region → relation → motion difference → pose/keypoints → before/after state and optional VLM listwise comparison&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Deterministic state/transition checks baseline → Optional VLM verifier candidate&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; SemanticMomentHypothesis list with frame/time/type/window/scores/states/evidence/status&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; semantic-moment-hypotheses&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Near-miss frame → Wrong moment definition → Unstable count/relation&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Return top local alternatives with explicit uncertainty." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="500" height="460" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_P05_M30" value="&lt;b&gt;M30 — Evidence Verifier&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Independent checks; no single creator/verifier model&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; SemanticMomentHypothesis → Raw frames/clip → Object/OCR/ASR evidence&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Deterministic validation → Independent model checks when configured → Contradiction detection&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Rule checks baseline → Optional independent model verifier&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; VerifiedEvidencePacket → RejectedHypothesis → InsufficientEvidence&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; verification-report&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Self-verification bias → Unsupported hypothesis&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Reject or mark insufficient evidence; retain verified mapping-only candidate if policy allows." style="shape=rhombus;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1990" y="100" width="820" height="460" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_P05_M31" value="&lt;b&gt;M31 — Q&amp;amp;A Answer Type Router&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Count · Color · Object · Person · Action · Location · OCR · Speech · Yes/No · Temporal&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Question → Verified event interval&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Classify required evidence and extractor&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Rule/template answer type routing&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; AnswerType → Evidence requirement&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; answer-type-decision&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Ambiguous question type&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Multi-hypothesis routing under bounded budget." style="shape=rhombus;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2920" y="100" width="380" height="340" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_P05_M32" value="&lt;b&gt;M32 — Q&amp;amp;A Answer Extractor&lt;/b&gt;&lt;br&gt;&lt;i&gt;[OPTIONAL] Extract by evidence type&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; AnswerType → Verified clip → Object/OCR/ASR evidence&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Run evidence-specific extraction → Normalize canonical answer → Preserve confidence and refs&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Deterministic extractors where possible → Optional VLM&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; raw_answer → canonical_answer → answer_type → answer_confidence → supporting evidence&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; answer-hypothesis&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Double count → Wrong crop → OCR/ASR error → Unsupported VLM answer&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Return only evidence-supported alternatives or insufficient evidence." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;dashed=1;dashPattern=5 3;" vertex="1" parent="1">
          <mxGeometry x="3330" y="100" width="500" height="420" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_P05_M33" value="&lt;b&gt;M33 — Answer-Evidence Consistency&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] No answer without evidence reference&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Answer hypothesis → VerifiedEvidencePacket&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Validate answer support → Temporal alignment and contradiction flags&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Schema and evidence-reference checks&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Grounded answer or rejection&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; answer-evidence-check&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Dangling evidence ref → Answer/clip contradiction&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Reject unsupported answer and preserve verified event candidate." style="shape=rhombus;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3860" y="100" width="450" height="360" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_E05_01" value="refined interval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;" edge="1" parent="1" source="PAGE_05_P05_M27" target="PAGE_05_P05_M28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_E05_02" value="EVIDENCE: dense raw frames" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#be123c;" edge="1" parent="1" source="PAGE_05_P05_M28" target="PAGE_05_P05_M29">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_E05_03" value="EVIDENCE: moment hypotheses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#be123c;" edge="1" parent="1" source="PAGE_05_P05_M29" target="PAGE_05_P05_M30">
          <mxGeometry relative="1" as="geometry" />
