        <mxCell id="PAGE_06_P06_Q1" value="&lt;b&gt;QA-1 — Event Description + Question&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Q&amp;amp;A request&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TAI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Event description → Question&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Preserve query and identify expected answer schema&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Q&amp;amp;A request contract&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Q&amp;amp;A query&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; query-ledger&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_Q2" value="&lt;b&gt;QA-2 — Event Retrieval &amp;amp; Video Ranking&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Find event before answering&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Q&amp;amp;A query → Corpus indexes&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Event retrieval → Fusion/grouping → Candidate Video ranking&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Multimodal retrieval baseline&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; CandidateVideo list&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; qa-candidate-videos&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="630" width="360" height="290" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_Q3" value="&lt;b&gt;QA-3 — Event Interval &amp;amp; Evidence Collector&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Localize supporting clip first&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; CandidateVideo → Event query&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; In-video interval localization → Collect object/OCR/ASR/clip evidence&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Local search and evidence tools&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Grounded event interval and evidence&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; qa-evidence-context&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="630" width="380" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_Q4" value="&lt;b&gt;QA-4 — Answer Type &amp;amp; Extractor&lt;/b&gt;&lt;br&gt;&lt;i&gt;[OPTIONAL] Count/color/object/person/action/location/text/speech/yes-no/temporal&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Question → Grounded evidence&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Route answer type → Extract raw and canonical answer&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Evidence-specific extractor → Optional VLM&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Answer hypothesis with evidence refs&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; answer-hypothesis&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;dashed=1;dashPattern=5 3;" vertex="1" parent="1">
          <mxGeometry x="1170" y="630" width="440" height="320" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_Q5" value="&lt;b&gt;QA-5 — Semantic Frame &amp;amp; Consistency&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Answer and submission frame share grounded evidence&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Answer hypothesis → Dense event window&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Semantic frame localization → Answer-evidence consistency → Verification&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Moment Localizer → Evidence Verifier&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Verified Q&amp;amp;A tuples&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; verified-qa-evidence-packets&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="630" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_Q6" value="&lt;b&gt;QA-6 — Ranked Q&amp;amp;A Answers&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] video_id, frame_id, answer&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TAI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Verified Q&amp;amp;A tuples&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Rank tuple diversity; answer alternatives only under real uncertainty&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Ranked Answer List Constructor&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Up to 100 Q&amp;amp;A tuples&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; qa-submission&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2070" y="630" width="350" height="280" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_T1" value="&lt;b&gt;TRAKE-1 — Narrative Event Sequence&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Ordered or structured multi-event query&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TAI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Narrative event sequence&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Preserve explicit order and same-video requirement&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; TRAKE request schema&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; TRAKE query&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; query-ledger&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1160" width="280" height="270" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_T2" value="&lt;b&gt;TRAKE-2 — Query Event Graph&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] QueryEvent nodes, relations and moment definitions&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; TRAKE query&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Compile events → hard/soft temporal/entity constraints&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Rule parser baseline → Bounded LLM candidate&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Query Event Graph&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; query-event-graph&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="ellipse;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="1160" width="350" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_T3" value="&lt;b&gt;TRAKE-3 — Retrieval per Event &amp;amp; Aggregate by Video&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Correct video has highest priority&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Query Event Graph → Corpus indexes&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Retrieve each QueryEvent → Aggregate coverage/order feasibility by video → Rank CandidateVideo&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Task-aware Candidate Video Ranker&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Ranked CandidateVideo list&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; trake-video-ranking&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="1160" width="420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_T4" value="&lt;b&gt;TRAKE-4 — Candidate Graph &amp;amp; Event Matching&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Query-local graph for top videos&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Top CandidateVideo → Query Event Graph → Local evidence&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Build Candidate Local Event Graph → Produce EventMatchMatrix&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Typed local graph and evidence matcher&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; EventMatchMatrix and local graph&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; candidate-graph → event-match-matrix&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1160" width="410" height="330" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_T5" value="&lt;b&gt;TRAKE-5 — DP/Beam Temporal Solver&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Top-M event chains&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; EventMatchMatrix → Temporal/entity constraints&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Optimize semantic match → order → coverage → compactness and penalties&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Dynamic Programming → Beam Search → Monotonic Alignment&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Top-M EventChain hypotheses&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; event-chain-hypotheses&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="1160" width="380" height="320" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_T6" value="&lt;b&gt;TRAKE-6 — Moment Localization per Event&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CANDIDATE] Exact semantics after chain alignment&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; EventChain hypotheses → Raw video&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Dense decode each event interval → Localize semantic moments → Verify chain and evidence&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Semantic Moment Localizer → Evidence Verifier&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Verified event moment chains&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; verified-trake-chains&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2050" y="1160" width="420" height="340" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_06_P06_T7" value="&lt;b&gt;TRAKE-7 — Ranked TRAKE Answers&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] video_id, frame_1, ..., frame_n&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TAI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Verified event moment chains&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Rank top chains and bounded moment alternatives without Cartesian explosion&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Ranked Answer List Constructor&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Up to 100 TRAKE tuples&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; trake-submission&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic fallback theo contract." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
