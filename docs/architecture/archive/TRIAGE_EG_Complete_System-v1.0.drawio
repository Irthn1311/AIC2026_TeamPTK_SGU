        <mxCell id="PAGE_02_E02_06E" value="ARTIFACT: ASR spans" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_02_P02_M56" target="PAGE_02_P02_M6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_02_E02_06F" value="ARTIFACT: captions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_02_P02_M57" target="PAGE_02_P02_M6">
          <mxGeometry relative="1" as="geometry" />
