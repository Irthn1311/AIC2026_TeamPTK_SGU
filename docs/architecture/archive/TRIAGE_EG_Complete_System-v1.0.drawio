  <diagram id="PAGE_08" name="08 — Contracts, Artifacts &amp; Ownership">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PAGE_08_G08_RECORDS" value="Core Records &amp;amp; Grounded Result Contracts" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="5740" height="600" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_G08_OWNERS" value="Team Artifact Flow &amp;amp; Ownership" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#e2e8f0;strokeColor=#475569;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="20" y="650" width="4200" height="600" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_VIDEO" value="&lt;b&gt;C1 — VideoRecord&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT_TEMPLATE] video_id · path · batch · fps · frames · duration · dataset version&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; KHOA&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Audited video metadata&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Validate non-empty ID → positive FPS → non-negative frame/duration&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Frozen dataclass&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Canonical video contract&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; video-manifest&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Invalid FPS or path&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Reject invalid record." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#172554;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="360" height="280" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_SHOT" value="&lt;b&gt;C2 — ShotRecord&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT_TEMPLATE] shot/video · frame/time interval · detector · confidence&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHAT&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; VideoRecord → Shot detection output&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Validate inclusive start/end frame and time&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Frozen dataclass&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Shot interval contract&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; shot-manifest&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Reversed interval&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Full-video shot in template only." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#2e1065;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="350" height="280" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_FRAME" value="&lt;b&gt;C3 — FrameRecord&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT_TEMPLATE] frame_uid · video · actual_frame_id · timestamp · policy · shot · extraction&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHAT&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; VideoRecord → ShotRecord → Selector result&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Preserve raw-video frame coordinate and source policy&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Frozen dataclass&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Retrieval frame contract&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; frame-bank-manifest&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Keyframe order used as actual ID&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Re-map through raw video and FrameMap." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#2e1065;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="100" width="390" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_FEATURE" value="&lt;b&gt;C4 — FeatureRecord&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT_TEMPLATE] frame · model/version · row · dimension · normalized · artifact&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHAT&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; FrameRecord → Encoder output&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Bind contiguous feature row and exact model metadata&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; JSONL manifest + NumPy matrix&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Feature row contract&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; feature-manifest&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Orphan row → Wrong model version&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Reject inconsistent feature store." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#2e1065;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1250" y="100" width="390" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_CFRAME" value="&lt;b&gt;C5 — CandidateFrame&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT_TEMPLATE] video/frame/time · score · rank · source branch&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Index result → FrameRecord mapping&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Map index ID to actual submission coordinates&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Frozen dataclass&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Ranked frame candidate&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; retrieval-results&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Unknown frame UID&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Reject orphan index result." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1670" y="100" width="360" height="280" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_CVIDEO" value="&lt;b&gt;C6 — CandidateVideo&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] video score · best frames · event count · branches · order feasibility&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Grouped CandidateFrame → QueryEvent coverage&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Aggregate evidence and order feasibility&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Current score aggregate; extended task-aware contract&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Ranked video candidate&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; candidate-video-ranking&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Wrong video → Missing event&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Best-frame plus modality agreement." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2060" y="100" width="390" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_QEVENT" value="&lt;b&gt;C7 — QueryEvent&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] source span · roles · moment definition · hard/soft constraints&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Compiled query&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Represent explicit/inferred/hypothesis semantics&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Typed graph node contract&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; QueryEvent node&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; query-event-graph&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Ambiguous role&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Multiple conservative hypotheses." style="ellipse;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2480" y="100" width="390" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_SEVENT" value="&lt;b&gt;C8 — SegmentEvent&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] interval · descriptions · evidence · confidence · status · provenance&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Candidate timeline and evidence refs&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Represent event interval hypothesis&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Versioned local graph node&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; SegmentEvent node&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; candidate-local-event-graph&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Shot/event conflation&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Keep segment_hypothesis status." style="ellipse;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2900" y="100" width="390" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_MOMENT" value="&lt;b&gt;C9 — SemanticMomentHypothesis&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CANDIDATE] event · frame · moment type · scores · evidence · verification&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; DenseFrameWindow → Moment definition&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Score exact semantic moment with before/after states&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Semantic Moment Localizer contract&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Moment hypothesis&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; semantic-moment-hypotheses&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Near-miss frame&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Return top alternatives with uncertainty." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3320" y="100" width="410" height="320" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_PACKET" value="&lt;b&gt;C10 — EvidencePacket&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Full grounded and verified result&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; CandidateVideo → EventChain → Semantic moments → Evidence → Answer hypotheses → Provenance&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Bind result fields to evidence references and verification status&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Grounded result contract&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; EvidencePacket&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; evidence-packet&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Unsupported field&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Mark incomplete and block unsupported output." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3760" y="100" width="400" height="320" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_RUN" value="&lt;b&gt;C11 — RunManifest&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT_TEMPLATE] run · git commit · config · data/model versions · artifact · status&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; KHOA&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Execution context → Exact config and versions&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Record reproducibility metadata beside every artifact&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; JSON manifest and used_config.yaml&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; RunManifest&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; run_manifest.json&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Unknown commit → Missing version&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Record UNKNOWN explicitly; never omit field." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4190" y="100" width="400" height="320" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_KHOA" value="&lt;b&gt;OWN-1 — Khoa — Data &amp;amp; Kaggle&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CONFIRMED] Nguyễn Đăng Khoa&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; KHOA&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Raw Data&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Audit and package environment&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Data/Kaggle workflow&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; VideoManifest → Kaggle Dataset/Environment&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; data audit → environment manifest&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Missing dataset&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Quarantine invalid records." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#172554;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="730" width="420" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_PHAT" value="&lt;b&gt;OWN-2 — Phát — Frame Bank &amp;amp; Features&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CONFIRMED] Phát Lê&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHAT&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; VideoManifest&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Shot/frame selection and feature extraction&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Frame Bank and encoder contracts&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; ShotRecord → FrameRecord → FeatureRecord&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; frame bank → feature store&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Bad frame mapping&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; BTC and uniform coverage." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#2e1065;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="730" width="430" height="320" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_PHUC" value="&lt;b&gt;OWN-3 — Phúc — Retrieval, Ranking &amp;amp; Evaluation&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CONFIRMED] Hồng Phúc&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; FeatureRecord&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Index → retrieve → group → rank and evaluate&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; VectorIndex → RRF → CandidateVideo ranker → Metrics&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; CandidateFrame → CandidateVideo → EvaluationReport&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; indexes → retrieval results → evaluation reports&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Low video recall&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Exact visual baseline." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="730" width="460" height="330" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_TRI" value="&lt;b&gt;OWN-4 — Tri — Architecture, Graph, Agent &amp;amp; Integration&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CONFIRMED] Hữu Tri&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; CandidateVideo&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Query/Candidate graphs → EventChain → Semantic moments → Agent integration&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; DP/Beam baseline and bounded control plane&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; EventChain → Semantic moments → EvidencePacket&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; graphs → chains → evidence packets&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Unsupported hypothesis&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Deterministic retrieval-first path." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1460" y="730" width="480" height="330" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_08_P08_TAI" value="&lt;b&gt;OWN-5 — Tài — UI, Output &amp;amp; Interaction&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CONFIRMED] Nguyễn Tài&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TAI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; EvidencePacket&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Present UI/timeline → Candidate verification and submission interaction&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; UI research and output contracts; runtime deferred&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Reviewed ranked submission&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; UI/timeline designs → submission&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Lost provenance in UI&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Plain evidence-backed ranked list." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1970" y="730" width="450" height="320" as="geometry" />
