        <mxCell id="PAGE_07_G07_AGENT" value="Bounded Agent Control Plane" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#fef3c7;strokeColor=#ca8a04;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
