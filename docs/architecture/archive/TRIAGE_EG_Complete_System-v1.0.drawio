          <mxGeometry x="2230" y="20" width="1980" height="780" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_G07_ENV" value="Execution Environment" style="swimlane;html=1;rounded=1;collapsible=0;startSize=34;horizontal=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;fontSize=15;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="4240" y="20" width="760" height="780" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_P07_M34" value="&lt;b&gt;M34 — Tool Registry&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Validated schemas and implementations&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Tool implementations and contracts&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Register names → versions → input/output schemas and availability&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; visual_frame_search → segment_search → object_search → OCR_search → ASR_search → caption_search → metadata_search → group_and_fuse → candidate_video_ranker → in_video_search → build_candidate_graph → event_matcher → temporal_chain_solver → entity_consistency_check → dense_frame_decoder → semantic_moment_localizer → evidence_verifier → QA_answer_extractor → answer_normalizer → ranked_answer_constructor → submission_formatter → official_metric_evaluator&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Versioned ToolRegistry&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; tool-registry-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Missing tool → Version mismatch&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Mark unavailable tool and route deterministic supported subset." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="430" height="470" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_P07_M35" value="&lt;b&gt;M35 — Bounded Agent Planner&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CANDIDATE] Understand · plan · choose · inspect · refine · verify · stop&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Original query → Task policy → ToolRegistry → Budget&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Plan → Execute → Inspect → Maximum one revise → Stop or fallback&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Bounded structured planner TBD&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; ExecutionPlan and tool calls&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; agent-plan-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Invalid plan → Loop → Hallucinated tool&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Invoke deterministic Fallback Controller." style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="440" height="470" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_P07_M36" value="&lt;b&gt;M36 — Plan Validator&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Contract, temporal order, evidence and budget guard&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; ExecutionPlan → ToolRegistry → TaskPolicy&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Check tool exists → schema compatibility → temporal solver use → video rank before TRAKE refinement → Q&amp;amp;A evidence before answer → VLM budget → repeated plan → Internet dependency and frame mapping&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Deterministic plan rules&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; ValidatedPlan or rejection&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; plan-validation-report&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Missed unsafe plan → False rejection&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Use deterministic task pipeline." style="shape=rhombus;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="100" width="430" height="440" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_P07_M37" value="&lt;b&gt;M37 — Budget Manager&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Bound query variants, branches, videos, graph, frames and model calls&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; ValidatedPlan → Latency/compute policy&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Limit variants → retrieval branches → candidate videos → graph nodes → decoded frames → VLM calls → revise rounds and latency&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Plan → execute → inspect → max one revise → stop/fallback&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Execution allowance and stop reason&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; budget-trace&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Budget overflow → Premature stop&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Preserve primary retrieval and verification minimum." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1450" y="100" width="340" height="400" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_P07_M38" value="&lt;b&gt;M38 — Fallback Controller&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Original query → visual retrieval → grouping → neighbors → local refinement → output&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Original query → Failure/rejection signal&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Execute deterministic retrieval-first pipeline&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Primary visual branch and local refinement&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Fallback evidence candidates&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; fallback-execution-trace&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Empty primary retrieval&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Return explicit insufficient evidence rather than fabricated output." style="shape=rhombus;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1820" y="100" width="340" height="400" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_P07_M39" value="&lt;b&gt;M39 — Evidence Packet&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Full grounded result and execution provenance&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TRI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Query/task/hypotheses → CandidateVideo scores → Matched events/chains/moments → Entity and multimodal evidence → Answers → Contradictions → Provenance → Verification&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Package schema-valid grounded result and submission candidates&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; EvidencePacket contract&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; EvidencePacket&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; evidence-packet-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Dangling evidence ref → Missing provenance&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Mark packet incomplete and block unsupported fields." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2270" y="100" width="420" height="440" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_P07_M40" value="&lt;b&gt;M40 — Ranked Answer List Constructor&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BASELINE] Precision at top, coverage and diversity at depth&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TAI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Verified EvidencePacket list&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; KIS meaningful frame/video alternatives → Q&amp;amp;A tuple diversity only under real uncertainty → TRAKE top chains and bounded moment beams → Suppress useless duplicates&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Task-specific rank construction without full Cartesian explosion&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Up to 100 ranked answer hypotheses&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; ranked-answer-list-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Top-rank imprecision → Duplicate flooding → Beam explosion&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Score-sorted verified candidates with conservative deduplication." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2720" y="100" width="430" height="440" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_P07_M41" value="&lt;b&gt;M41 — Submission Formatter&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT_TEMPLATE] KIS, Q&amp;amp;A and TRAKE official tuple formats&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; TAI&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Ranked answer list → TaskPolicy&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Format KIS video/frame → Q&amp;amp;A video/frame/answer → TRAKE video/frame sequence&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Task schema formatter&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Submission records&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; submission-file&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Wrong field count → Invalid frame ID&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Reject invalid tuple before submission." style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3180" y="100" width="330" height="360" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_P07_M42" value="&lt;b&gt;M42 — Official Metric Evaluator&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CURRENT_TEMPLATE] R@1 · R@5 · R@20 · R@50 · R@100 · Final Score&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; PHUC&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Submission records → Ground truth&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Compute task R-Score and ranked metrics → Report diagnostics&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; Current KIS/Q&amp;amp;A/TRAKE metric simulator&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; EvaluationReport&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; evaluation-report-vX&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Rule drift → Invalid prediction count&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Version evaluator and flag divergence from official rules." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3540" y="100" width="620" height="440" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_P07_M43" value="&lt;b&gt;M43 — Execution Environment&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CONFIRMED] Local → GitHub → Kaggle&lt;/i&gt;&lt;br&gt;&lt;b&gt;Owner:&lt;/b&gt; KHOA&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; Source code → Config → Exact commit → Attached Kaggle data&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Clone repo → Checkout exact commit → Install package → Attach data → Call scripts&lt;br&gt;&lt;b&gt;Implementation:&lt;/b&gt; GitHub workflow → Kaggle bootstrap notebook&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Reproducible run artifacts&lt;br&gt;&lt;b&gt;Artifact:&lt;/b&gt; RunManifest → Kaggle output bundle&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; Wrong commit → Internet dependency → Missing dataset mount&lt;br&gt;&lt;b&gt;Fallback:&lt;/b&gt; Package code/dependencies as Kaggle Dataset for offline execution." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4280" y="100" width="680" height="470" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_E07_01" value="tool contracts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#a16207;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_07_P07_M34" target="PAGE_07_P07_M35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_E07_02" value="proposed plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#a16207;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_07_P07_M35" target="PAGE_07_P07_M36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_E07_03" value="validated plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#a16207;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_07_P07_M36" target="PAGE_07_P07_M37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_E07_04" value="FALLBACK: invalid or failed plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b91c1c;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_07_P07_M36" target="PAGE_07_P07_M38">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_E07_05" value="EVIDENCE: bounded verified execution" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#be123c;" edge="1" parent="1" source="PAGE_07_P07_M37" target="PAGE_07_P07_M39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_07_E07_06" value="FALLBACK: fallback evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b91c1c;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="PAGE_07_P07_M38" target="PAGE_07_P07_M39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
