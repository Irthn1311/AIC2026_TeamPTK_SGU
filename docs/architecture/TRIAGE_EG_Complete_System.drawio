        <mxCell id="PAGE_00_P00_CRIT" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;L1 — Criticality&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Core system] [PLANNED] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;CORE · CONDITIONAL · OPTIONAL · DEFERRED&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; External or page-entry input for Criticality on PAGE_00&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; independent axis to Maturity [P00_MAT]" tooltip="Responsibility: CORE · CONDITIONAL · OPTIONAL · DEFERRED&#xa;Non-responsibility: Does not fabricate benchmark outcomes or strip evidence provenance.&#xa;Implementation: Versioned output envelope, task formatter and provenance-preserving serialization.&#xa;Artifacts: CriticalityArtifact&#xa;Metrics: contract validity → submission validity → serialization latency&#xa;Failure modes: evidence/output schema mismatch or invalid task submission row&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#166534;strokeWidth=3;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_00_P00_MAT" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;L2 — Maturity&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Core system] [PLANNED] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;CURRENT_TEMPLATE · PLANNED · BASELINE · EXPERIMENTAL · SELECTED · VALIDATED&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; independent axis from Criticality [P00_CRIT]&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; independent axis to Source basis [P00_SRC]" tooltip="Responsibility: CURRENT_TEMPLATE · PLANNED · BASELINE · EXPERIMENTAL · SELECTED · VALIDATED&#xa;Non-responsibility: Does not fabricate benchmark outcomes or strip evidence provenance.&#xa;Implementation: Versioned output envelope, task formatter and provenance-preserving serialization.&#xa;Artifacts: MaturityArtifact&#xa;Metrics: contract validity → submission validity → serialization latency&#xa;Failure modes: evidence/output schema mismatch or invalid task submission row&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#166534;strokeWidth=3;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_00_P00_SRC" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;L3 — Source basis&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Core system] [PLANNED] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;BTC_CONFIRMED · TEAM_DECISION · RESEARCH_CANDIDATE · SOFTWARE_TEMPLATE&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; independent axis from Maturity [P00_MAT]&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; Terminal page output: SourcebasisArtifact" tooltip="Responsibility: BTC_CONFIRMED · TEAM_DECISION · RESEARCH_CANDIDATE · SOFTWARE_TEMPLATE&#xa;Non-responsibility: Does not fabricate benchmark outcomes or strip evidence provenance.&#xa;Implementation: Versioned output envelope, task formatter and provenance-preserving serialization.&#xa;Artifacts: SourcebasisArtifact&#xa;Metrics: contract validity → submission validity → serialization latency&#xa;Failure modes: evidence/output schema mismatch or invalid task submission row&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#166534;strokeWidth=3;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
