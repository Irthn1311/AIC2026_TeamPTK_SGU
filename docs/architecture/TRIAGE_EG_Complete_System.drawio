  <diagram id="PAGE_05" name="05 — Fine Grounding &amp; Verification">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3380" pageHeight="1220" math="0" shadow="0">
