        <mxCell id="PAGE_01_G01_REASON" parent="1" style="swimlane;html=1;rounded=1;collapsible=0;startSize=38;horizontal=1;fillColor=#ffedd5;strokeColor=#ea580c;fontStyle=1;fontSize=18;opacity=28;" value="Row 3 — Reasoning, grounding &amp; output" vertex="1">
