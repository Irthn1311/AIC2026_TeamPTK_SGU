        <mxCell id="PAGE_01_G01_BUS" parent="1" style="swimlane;html=1;rounded=1;collapsible=0;startSize=38;horizontal=1;fillColor=#fef3c7;strokeColor=#ca8a04;fontStyle=1;fontSize=18;opacity=28;" value="Agent Control Bus" vertex="1">
          <mxGeometry height="190" width="3900" x="20" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_01_P01_UI" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e2e8f0;strokeColor=#166534;strokeWidth=3;fontColor=#0f172a;fontSize=11;" tooltip="Responsibility: Own the Interactive UI / Operator Console boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not fabricate benchmark outcomes or strip evidence provenance.&#xa;Implementation: Operator UI contract for query/task input, video-grouped results, timeline, neighbors, preview, evidence, feedback and submission.&#xa;Artifacts: InteractiveUI/OperatorConsoleArtifact&#xa;Metrics: contract validity → submission validity → serialization latency&#xa;Failure modes: evidence/output schema mismatch or invalid task submission row&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TAI; reviewers=PHUC" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;A1 — Interactive UI / Operator Console&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Interactive mode] [PLANNED] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Own the Interactive UI / Operator Console boundary and produce only its declared page…&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; External or page-entry input for Interactive UI / Operator Co…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; query + feedback to Application Backend / Orchestrator [P01_B…" vertex="1">
          <mxGeometry height="120" width="960" x="70" y="90" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_01_P01_BACKEND" parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#166534;strokeWidth=3;fontColor=#713f12;fontSize=11;" tooltip="Responsibility: Own the Application Backend / Orchestrator boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not invent tools, IDs, timestamps, scores, identity or evidence.&#xa;Implementation: Single application-service boundary for sessions, core-pipeline calls, feedback, results and traces; not microservices.&#xa;Artifacts: ApplicationBackend/OrchestratorArtifact&#xa;Metrics: policy validity → fallback rate → control latency&#xa;Failure modes: invalid plan, unavailable tool, exhausted budget or untraceable decision&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TAI; reviewers=PHUC" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;A2 — Application Backend / Orchestrator&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;[CORE: Application service] [PLANNED] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Own the Application Backend / Orchestrator boundary and produce only its declared pag…&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; query + feedback from Interactive UI / Operator Console [P01_…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; orchestrated request to Query Input &amp;amp; Session [P01_QUERY]" vertex="1">
