        <mxCell id="PAGE_01_G01_ON" parent="1" style="swimlane;html=1;rounded=1;collapsible=0;startSize=38;horizontal=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=18;opacity=28;" value="Row 2 — Online retrieval" vertex="1">
