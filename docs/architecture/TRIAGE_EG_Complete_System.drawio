        <mxCell id="PAGE_05_G05_QA" value="Row 2 — Q&amp;A evidence extraction" style="swimlane;html=1;rounded=1;collapsible=0;startSize=38;horizontal=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontStyle=1;fontSize=18;opacity=28;" vertex="1" parent="1">
          <mxGeometry x="20" y="630" width="3340" height="570" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_P05_CAND" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;G1 — CandidateVideo / EventChain&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Fine grounding] [BASELINE] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; External or page-entry input for CandidateVideo / EventChain on PAG…&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Validate schema, version and provenance for CandidateVideo / EventChain bef…&lt;br&gt;&lt;b&gt;Impl:&lt;/b&gt; Raw-video/evidence adapter with bounded dense decoding and explicit verific…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; candidate to In-video Search [P05_SEARCH]" tooltip="Responsibility: Own the CandidateVideo / EventChain boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not emit a verified answer when raw evidence is insufficient.&#xa;Implementation: Raw-video/evidence adapter with bounded dense decoding and explicit verification states.&#xa;Artifacts: CandidateVideo/EventChainArtifact&#xa;Metrics: frame-window hit → evidence coverage → localization latency&#xa;Failure modes: raw evidence unavailable or insufficient to verify/localize the requested moment&#xa;Fallback: Refine or re-search within budget; otherwise return insufficient evidence without an answer.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#166534;strokeWidth=3;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="750" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_05_P05_SEARCH" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;G2 — In-video Search&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Fine grounding] [BASELINE] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; candidate from CandidateVideo / EventChain [P05_CAND] → no: refine…&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Transform candidate from CandidateVideo / EventChain [P05_CAND] into search…&lt;br&gt;&lt;b&gt;Impl:&lt;/b&gt; Raw-video/evidence adapter with bounded dense decoding and explicit verific…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; search window to Refined Event Interval [P05_INTERVAL]" tooltip="Responsibility: Own the In-video Search boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not emit a verified answer when raw evidence is insufficient.&#xa;Implementation: Raw-video/evidence adapter with bounded dense decoding and explicit verification states.&#xa;Artifacts: In-videoSearchArtifact&#xa;Metrics: frame-window hit → evidence coverage → localization latency&#xa;Failure modes: raw evidence unavailable or insufficient to verify/localize the requested moment&#xa;Fallback: Refine or re-search within budget; otherwise return insufficient evidence without an answer.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#166534;strokeWidth=3;fontColor=#881337;fontSize=11;" vertex="1" parent="1">
