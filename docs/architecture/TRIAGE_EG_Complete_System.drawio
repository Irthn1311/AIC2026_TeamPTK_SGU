        <mxCell id="PAGE_01_P01_DENSE" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#166534;strokeWidth=3;fontColor=#881337;fontSize=11;" tooltip="Responsibility: Own the In-video Search &amp; Dense Decode boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not emit a verified answer when raw evidence is insufficient.&#xa;Implementation: Raw-video/evidence adapter with bounded dense decoding and explicit verification states.&#xa;Artifacts: In-videoSearch&amp;DenseDecodeArtifact&#xa;Metrics: frame-window hit → evidence coverage → localization latency&#xa;Failure modes: raw evidence unavailable or insufficient to verify/localize the requested moment&#xa;Fallback: Refine or re-search within budget; otherwise return insufficient evidence without an answer.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;R5 — In-video Search &amp;amp; Dense Decode&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;[CORE: Grounding] [BASELINE] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Own the In-video Search &amp;amp; Dense Decode boundary and produce only its declared page-lo…&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; top videos from Fast Lane [P01_FAST] → Top-M chains from Temp…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; coarse interval to Semantic Moment Localizer [P01_SML]" vertex="1">
          <mxGeometry height="130" width="700" x="3150" y="900" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_01_P01_SML" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe4e6;strokeColor=#166534;strokeWidth=3;fontColor=#881337;fontSize=11;" tooltip="Responsibility: Own the Semantic Moment Localizer boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not emit a verified answer when raw evidence is insufficient.&#xa;Implementation: Dense raw-video decoding inside a coarse interval followed by moment-type-specific frame selection.&#xa;Artifacts: SemanticMomentLocalizerArtifact&#xa;Metrics: frame-window hit → nearest-frame distance → moment localization error&#xa;Failure modes: raw evidence unavailable or insufficient to verify/localize the requested moment&#xa;Fallback: Refine or re-search within budget; otherwise return insufficient evidence without an answer.&#xa;Owner: architecture=TRI; implementation=TAI,PHAT; reviewers=PHUC" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;R6 — Semantic Moment Localizer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: TRAKE] [EXPERIMENTAL] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Own the Semantic Moment Localizer boundary and produce only its declared page-local c…&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; coarse interval from In-video Search &amp; Dense Decode [P01_DENS…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; semantic moments to Evidence Verifier / Q&amp;A Extractor [P01_VE…" vertex="1">
