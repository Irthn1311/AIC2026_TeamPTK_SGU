  <diagram id="PAGE_03" name="03 — Online Query &amp; Retrieval">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3380" pageHeight="1410" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PAGE_03_TITLE" value="03 — Online Query &amp; Retrieval" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="1500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_G03_QUERY" value="Row 1 — Query understanding" style="swimlane;html=1;rounded=1;collapsible=0;startSize=38;horizontal=1;fillColor=#fef3c7;strokeColor=#ca8a04;fontStyle=1;fontSize=18;opacity=28;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="3340" height="300" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_G03_BRANCH" value="Row 2A — Per-modality ranked retrieval" style="swimlane;html=1;rounded=1;collapsible=0;startSize=38;horizontal=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=18;opacity=28;" vertex="1" parent="1">
          <mxGeometry x="20" y="380" width="3340" height="450" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_G03_RANK" value="Row 2B — Fusion, grouping &amp; lane decision" style="swimlane;html=1;rounded=1;collapsible=0;startSize=38;horizontal=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=18;opacity=28;" vertex="1" parent="1">
          <mxGeometry x="20" y="870" width="3340" height="520" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_INPUT" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;Q1 — Query / API Input&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Core system] [BASELINE] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; External or page-entry input for Query / API Input on PAGE_03&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Transform External or page-entry input for Query / API Input on PAGE_03 int…&lt;br&gt;&lt;b&gt;Impl:&lt;/b&gt; Deterministic policy/registry/budget implementation with allow-listed actio…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; query to Query Ledger [P03_LEDGER]" tooltip="Responsibility: Own the Query / API Input boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not invent tools, IDs, timestamps, scores, identity or evidence.&#xa;Implementation: Deterministic policy/registry/budget implementation with allow-listed actions and traceable fallback.&#xa;Artifacts: Query/APIInputArtifact&#xa;Metrics: policy validity → fallback rate → control latency&#xa;Failure modes: invalid plan, unavailable tool, exhausted budget or untraceable decision&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TAI; reviewers=PHUC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#166534;strokeWidth=3;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_LEDGER" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;Q2 — Query Ledger&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Core system] [BASELINE] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; query from Query / API Input [P03_INPUT]&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Validate schema, version and provenance for Query Ledger before artifact ha…&lt;br&gt;&lt;b&gt;Impl:&lt;/b&gt; Immutable query/session state with task, hypotheses, feedback and execution…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; immutable session to Task Policy [P03_POLICY]" tooltip="Responsibility: Own the Query Ledger boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not invent tools, IDs, timestamps, scores, identity or evidence.&#xa;Implementation: Immutable query/session state with task, hypotheses, feedback and execution-version references.&#xa;Artifacts: QueryLedgerArtifact&#xa;Metrics: policy validity → fallback rate → control latency&#xa;Failure modes: invalid plan, unavailable tool, exhausted budget or untraceable decision&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#166534;strokeWidth=3;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="110" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_POLICY" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;Q3 — Task Policy&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Core system] [BASELINE] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; immutable session from Query Ledger [P03_LEDGER]&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Apply allow-listed control for Task Policy with budget, validation and trac…&lt;br&gt;&lt;b&gt;Impl:&lt;/b&gt; Deterministic task and modality policy; select Fast/Graph eligibility witho…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; task contract to Query Compiler [P03_COMPILER]" tooltip="Responsibility: Own the Task Policy boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not invent tools, IDs, timestamps, scores, identity or evidence.&#xa;Implementation: Deterministic task and modality policy; select Fast/Graph eligibility without generating evidence.&#xa;Artifacts: TaskPolicyArtifact&#xa;Metrics: policy validity → fallback rate → control latency&#xa;Failure modes: invalid plan, unavailable tool, exhausted budget or untraceable decision&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#166534;strokeWidth=3;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="110" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_COMPILER" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;Q4 — Query Compiler&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Core system] [BASELINE] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; task contract from Task Policy [P03_POLICY]&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Transform task contract from Task Policy [P03_POLICY] into compiled query t…&lt;br&gt;&lt;b&gt;Impl:&lt;/b&gt; Compile natural-language input into typed retrieval clauses and versioned q…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; compiled query to Fast Probe [P03_PROBE]" tooltip="Responsibility: Own the Query Compiler boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not invent tools, IDs, timestamps, scores, identity or evidence.&#xa;Implementation: Compile natural-language input into typed retrieval clauses and versioned query hypotheses.&#xa;Artifacts: QueryCompilerArtifact&#xa;Metrics: policy validity → fallback rate → control latency&#xa;Failure modes: invalid plan, unavailable tool, exhausted budget or untraceable decision&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#166534;strokeWidth=3;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1690" y="110" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_PROBE" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;Q5 — Fast Probe&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Core system] [BASELINE] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; compiled query from Query Compiler [P03_COMPILER]&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Transform compiled query from Query Compiler [P03_COMPILER] into probe resu…&lt;br&gt;&lt;b&gt;Impl:&lt;/b&gt; Low-cost retrieval probe that records coverage and uncertainty signals befo…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; probe result to Modality Router [P03_ROUTER]" tooltip="Responsibility: Own the Fast Probe boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not invent tools, IDs, timestamps, scores, identity or evidence.&#xa;Implementation: Low-cost retrieval probe that records coverage and uncertainty signals before lane routing.&#xa;Artifacts: FastProbeArtifact&#xa;Metrics: policy validity → fallback rate → control latency&#xa;Failure modes: invalid plan, unavailable tool, exhausted budget or untraceable decision&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#166534;strokeWidth=3;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2230" y="110" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_ROUTER" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;Q6 — Modality Router&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Core system] [BASELINE] [TEAM_DECISION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; probe result from Fast Probe [P03_PROBE]&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Apply allow-listed control for Modality Router with budget, validation and…&lt;br&gt;&lt;b&gt;Impl:&lt;/b&gt; Dispatch only available registered retrieval branches; each branch returns…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; independent query to BTC visual search [P03_BTC] → independent quer…" tooltip="Responsibility: Own the Modality Router boundary and produce only its declared page-local contracts.&#xa;Non-responsibility: Does not invent tools, IDs, timestamps, scores, identity or evidence.&#xa;Implementation: Dispatch only available registered retrieval branches; each branch returns an independent rank list.&#xa;Artifacts: ModalityRouterArtifact&#xa;Metrics: policy validity → fallback rate → control latency&#xa;Failure modes: invalid plan, unavailable tool, exhausted budget or untraceable decision&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI; implementation=TRI; reviewers=PHUC" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fef3c7;strokeColor=#166534;strokeWidth=3;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2770" y="110" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PAGE_03_P03_BTC" value="&lt;font style=&#39;font-size:15px&#39;&gt;&lt;b&gt;R1 — BTC visual search&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;[CORE: Core retrieval] [BASELINE] [BTC_CONFIRMED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; independent query from Modality Router [P03_ROUTER]&lt;br&gt;&lt;b&gt;Process:&lt;/b&gt; Transform independent query from Modality Router [P03_ROUTER] into ranked l…&lt;br&gt;&lt;b&gt;Impl:&lt;/b&gt; Typed rank-list contracts, deterministic ranking/fusion policy and versione…&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; ranked list to RRF Fusion [P03_RRF]" tooltip="Responsibility: Return an independent ranked list; never add raw cross-modality scores&#xa;Non-responsibility: Does not declare final semantic truth or bypass evidence verification.&#xa;Implementation: Typed rank-list contracts, deterministic ranking/fusion policy and versioned index adapters.&#xa;Artifacts: BTCvisualsearchArtifact&#xa;Metrics: Recall@K → ranking latency → branch coverage&#xa;Failure modes: unavailable index or empty/invalid ranked candidate list&#xa;Fallback: Fail closed with a typed error and preserve the last valid versioned artifact or deterministic baseline path.&#xa;Owner: architecture=TRI,PHUC; implementation=PHUC; reviewers=PHUC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dcfce7;strokeColor=#166534;strokeWidth=3;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
