        <mxCell id="PAGE_05_G05_MAIN" value="Row 1 — Fine grounding on raw video" style="swimlane;html=1;rounded=1;collapsible=0;startSize=38;horizontal=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontStyle=1;fontSize=18;opacity=28;" vertex="1" parent="1">
